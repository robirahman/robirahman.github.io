---
import PageLayout from "../layouts/PageLayout.astro";
import TimelineItem from "../components/TimelineItem.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { loadPublications } from "../lib/bibtex";

const pubs = loadPublications();

const timelineEntries = [
  { year: "2005\u20132012", content: 'Middle/high school student at <a href="https://hbwoodlawn.apsva.us/" target="_blank" rel="noopener">H-B Woodlawn Secondary Program</a>' },
  { year: "2013\u20132016", content: 'Undergraduate student at <a href="https://www.wm.edu/" target="_blank" rel="noopener">College of William and Mary</a>' },
  { year: "2017\u20132020", content: 'Staff Engineer at <a href="https://www.fandr.com/" target="_blank" rel="noopener">Froehling &amp; Robertson</a>' },
  { year: "2020\u20132022", content: 'Graduate student at <a href="https://www.harvard.edu/" target="_blank" rel="noopener">Harvard University</a>' },
  { year: "2023\u20132025", content: 'Data Scientist at <a href="https://epoch.ai/" target="_blank" rel="noopener">Epoch AI</a>' },
  { year: "2025\u2013present", content: 'Data Scientist at <a href="https://techgov.intelligence.org/" target="_blank" rel="noopener">MIRI Technical Governance Team</a>' },
];
---

<PageLayout title="CV">
  <ul class="timeline">
    {timelineEntries.map((entry) => (
      <TimelineItem year={entry.year} content={entry.content} />
    ))}
  </ul>

  <hr />

  <h2>Publications</h2>
  <ul class="pub-list">
    {pubs.map((pub) => (
      <PublicationEntry pub={pub} />
    ))}
  </ul>
</PageLayout>
